# Yourmine backend configuration.
# Copy to .env and adjust as needed; every value below is the default.

# Interface the API listens on. Loopback by default: the API is
# unauthenticated, so exposing it to a network is an explicit opt-in.
YOURMINE_HOST=127.0.0.1
YOURMINE_PORT=8000

# Where finished audio files are written. Leave unset to auto-detect
# (~/Downloads, then ~/Desktop, then ~).
# YOURMINE_OUTPUT_DIR=

# Limits that keep one request from exhausting the process.
YOURMINE_MAX_BATCH_SIZE=20
YOURMINE_MAX_CONCURRENT_DOWNLOADS=3
YOURMINE_MAX_STORED_JOBS=200

# DEBUG, INFO, WARNING, ERROR
YOURMINE_LOG_LEVEL=INFO
