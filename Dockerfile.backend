FROM python:3.14-slim

# GHCR links a package to its repository when the image carries this
# label, which is what lets the repository's GITHUB_TOKEN push to it.
LABEL org.opencontainers.image.source="https://github.com/supremjerem/yourmine"
LABEL org.opencontainers.image.licenses="MIT"

# Install FFmpeg and system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend code
COPY backend/ ./backend/

# Run as an unprivileged user. The container writes only to its download
# volume, which is mounted at this user's home directory.
RUN useradd --create-home --uid 1000 yourmine \
    && mkdir -p /home/yourmine/Downloads \
    && chown -R yourmine:yourmine /home/yourmine /app
USER yourmine

# Inside the container the API must listen on all interfaces to be reachable
# through the published port; the host-side binding is what limits exposure.
ENV YOURMINE_HOST=0.0.0.0 \
    YOURMINE_PORT=8000 \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/')" || exit 1

# Serve without the reload watcher, which is a development-only feature.
CMD ["uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000"]
